diff --git a/src/monitored-reporting.test.js b/src/monitored-reporting.test.js
new file mode 100644
index 0000000..fdf8617
--- /dev/null
+++ b/src/monitored-reporting.test.js
@@ -0,0 +1,78 @@
+import { afterEach, expect, test, vi } from 'vitest';
+import * as Sentry from '@sentry/react';
+import { initializeReporting } from './scenario-reporting.js';
+
+vi.mock('@sentry/react', () => ({ init: vi.fn(), captureException: vi.fn() }));
+const revision = 'a'.repeat(40);
+afterEach(() => {
+  initializeReporting('validation', '');
+  vi.clearAllMocks();
+});
+
+test('monitored reporting uses the complete source revision and no automatic telemetry', () => {
+  expect(initializeReporting('demo', 'https://synthetic.invalid', revision)).toBe(true);
+  expect(Sentry.init).toHaveBeenCalledWith(
+    expect.objectContaining({
+      release: revision,
+      environment: 'demo',
+      sendDefaultPii: false,
+      defaultIntegrations: false,
+      autoSessionTracking: false,
+      sendClientReports: false,
+      enableLogs: false,
+    }),
+  );
+});
+
+for (const release of [undefined, '', 'short', 'A'.repeat(40), 'a'.repeat(41), `${revision}\n`]) {
+  test(`demo rejects missing or malformed revision ${JSON.stringify(release)}`, () => {
+    expect(initializeReporting('demo', 'https://synthetic.invalid', release)).toBe(false);
+    expect(Sentry.init).not.toHaveBeenCalled();
+  });
+}
+
+test('validation cannot initialize reporting even with a DSN and valid revision', () => {
+  expect(initializeReporting('validation', 'https://synthetic.invalid', revision)).toBe(false);
+  expect(Sentry.init).not.toHaveBeenCalled();
+});
+
+test('only fixed synthetic scenario metadata survives beforeSend', () => {
+  initializeReporting('demo', 'https://synthetic.invalid', revision);
+  const beforeSend = Sentry.init.mock.calls[0][0].beforeSend;
+  const event = {
+    event_id: 'b'.repeat(32),
+    timestamp: 123,
+    tags: { 'fixture.scenario': 'profile-name', secret: 'PRIVATE' },
+    exception: {
+      values: [
+        {
+          type: 'TypeError',
+          value: 'PRIVATE',
+          stacktrace: { frames: [{ context_line: 'PRIVATE' }] },
+        },
+      ],
+    },
+    user: { email: 'PRIVATE' },
+    request: { url: 'PRIVATE' },
+    breadcrumbs: [{ message: 'PRIVATE' }],
+    extra: { secret: 'PRIVATE' },
+    contexts: { private: 'PRIVATE' },
+    release: 'wrong',
+    environment: 'wrong',
+  };
+  expect(beforeSend(event)).toEqual({
+    event_id: 'b'.repeat(32),
+    timestamp: 123,
+    platform: 'javascript',
+    level: 'error',
+    release: revision,
+    environment: 'demo',
+    tags: { 'fixture.scenario': 'profile-name' },
+    fingerprint: ['eitri-fixture-v1', 'profile-name'],
+    exception: { values: [{ type: 'Error', value: 'Synthetic fixture scenario: profile-name' }] },
+  });
+  expect(beforeSend({ ...event, tags: {} })).toBe(null);
+  expect(beforeSend({ ...event, tags: { 'fixture.scenario': 'unknown' } })).toBe(null);
+  expect(beforeSend({ ...event, tags: { 'fixture.scenario': 'toString' } })).toBe(null);
+  expect(event.user.email).toBe('PRIVATE');
+});
diff --git a/src/scenario-reporting.js b/src/scenario-reporting.js
index 8fc565a..8f41bd6 100644
--- a/src/scenario-reporting.js
+++ b/src/scenario-reporting.js
@@ -6,2 +6,7 @@ let enabled = false;
-export function initializeReporting(environment, dsn) {
-  enabled = environment === 'demo' && typeof dsn === 'string' && dsn.length > 0;
+export function initializeReporting(environment, dsn, release) {
+  enabled =
+    environment === 'demo' &&
+    typeof dsn === 'string' &&
+    dsn.length > 0 &&
+    typeof release === 'string' &&
+    /^[a-f0-9]{40}$/.test(release);
@@ -9 +14,30 @@ export function initializeReporting(environment, dsn) {
-  Sentry.init({ dsn, environment: 'demo', release: metadata.release, sendDefaultPii: false });
+  Sentry.init({
+    dsn,
+    environment: 'demo',
+    release,
+    sendDefaultPii: false,
+    defaultIntegrations: false,
+    autoSessionTracking: false,
+    sendClientReports: false,
+    enableLogs: false,
+    // Only the four synthetic scenarios may leave this deliberately monitored build.
+    beforeSend(event) {
+      const scenario = metadata.scenarios.find(
+        (item) => item.id === event.tags?.['fixture.scenario'],
+      );
+      if (!scenario) return null;
+      return {
+        event_id: event.event_id,
+        timestamp: event.timestamp,
+        platform: 'javascript',
+        level: 'error',
+        environment: 'demo',
+        release,
+        tags: scenario.tags,
+        fingerprint: scenario.fingerprint,
+        exception: {
+          values: [{ type: 'Error', value: `Synthetic fixture scenario: ${scenario.id}` }],
+        },
+      };
+    },
+  });
