diff --git a/src/instrument.js b/src/instrument.js
index f77731a..5d2cbd6 100644
--- a/src/instrument.js
+++ b/src/instrument.js
@@ -1 +1 @@
-import { initializeReporting } from './scenario-reporting.js'
