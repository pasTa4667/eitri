{
  "name": "eitri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.5.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check:sdk": "node scripts/check-sdk.mjs",
    "probe:sdk": "node prototypes/sdk-compatibility.mjs",
    "check": "tsc --noEmit && node --check scripts/doctor.mjs && node --check scripts/check-sdk.mjs && node --check prototypes/sdk-compatibility.mjs && node --check prototypes/chromium/probe.mjs && node --check prototypes/chromium/run.mjs",
    "test": "node --test test/*.test.ts",
    "verify": "npm run check && npm test",
    "start": "node src/main.ts",
    "operator": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer cargo run --locked --manifest-path operator/Cargo.toml",
    "test:operator": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer cargo test --locked --manifest-path operator/Cargo.toml",
    "verify:all": "npm run verify && npm run test:operator",
    "probe:chromium": "node prototypes/chromium/run.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "typescript": "6.0.3"
  }
}
